# ============================================================
# fastapi-payment — environment template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ============================================================

# ==================== DATABASE ====================
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=payment_system

# Optional read-replica / analytics DBs (only registered if their
# REPLICA_DB_* / ANALYTICS_DB_* vars are present)
# REPLICA_DB_HOST=localhost
# REPLICA_DB_PORT=5432
# REPLICA_DB_USER=replica
# REPLICA_DB_PASSWORD=your_replica_password
# REPLICA_DB_NAME=payment_system_replica
# ANALYTICS_DB_HOST=localhost
# ANALYTICS_DB_NAME=payment_system_analytics

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=false

# ==================== APPLICATION ====================
APP_NAME=Payment System API
APP_VERSION=1.0.0
DEBUG=false
API_PREFIX=/api/v1

# ==================== AUTH / SECURITY ====================
# JWT verification — MUST match the auth gateway's signing secret (HS256).
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Master auth switch.
#   true  -> every /api/* request requires a valid bearer JWT.
#   false -> auth is disabled (use ONLY when a trusted gateway/BFF in
#            front already authenticates requests before they reach this service).
AUTH_REQUIRED=true

# Comma-separated ADMIN role names. Roles are managed dynamically in the
# gateway, so keep this configurable — do NOT hardcode role names in code.
# Any user whose role name (lowercased) is in this set is treated as admin.
# Superusers always pass regardless of this list.
ADMIN_ROLES=admin,superuser

# ==================== CORS ====================
# Defensive defaults: set the real origin(s) your frontend runs on.
# Wildcard "*" + credentials=true is rejected by browsers and unsafe — avoid it.
# Comma-separated list, NO spaces. Leave empty to allow no cross-origin requests.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_CREDENTIALS=false
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_HEADERS=*

# ==================== RATE LIMITING ====================
# Requests per minute per client IP, by tier.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STRICT_RPM=10
RATE_LIMIT_STANDARD_RPM=30
RATE_LIMIT_RELAXED_RPM=60
# Comma-separated TRUSTED reverse-proxy IPs. X-Forwarded-For is only honored
# when the immediate peer is in this list (prevents client IP spoofing).
# Leave empty if this service is reached directly (no proxy in front).
RATE_LIMIT_TRUSTED_PROXIES=
